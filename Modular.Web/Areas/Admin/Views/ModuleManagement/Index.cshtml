@model IReadOnlyList<Modular.Web.Support.ModuleDto>

<h1>Module management</h1>
<p>
    <a href="/Admin/ModuleManagement/Create">Create module</a>
</p>
<table>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Enabled</th>
        <th>License</th>
        <th>Actions</th>
    </tr>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.Id</td>
            <td>@m.Name</td>
            <td>@m.IsEnabled</td>
            <td>@m.RequiredLicense</td>
            <td>
                <a href="/Admin/ModuleManagement/Edit/@m.Id">Edit</a>
                <form style="display:inline" method="post" action="/Admin/ModuleManagement/Toggle/@m.Id">
                    <button>Toggle</button>
                </form>
                <form style="display:inline" method="post" action="/Admin/ModuleManagement/Delete/@m.Id">
                    <button>Delete</button>
                </form>
            </td>
        </tr>
    }
</table>