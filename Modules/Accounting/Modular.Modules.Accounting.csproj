<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<BaseOutputPath>D:\- Source Repository -\- Test -\Modular.DotNetCore.New\Modular.Web\Modules</BaseOutputPath>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>

		<!-- ۱. فعال‌سازی اجباری مانیفست Embedded -->
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
	</PropertyGroup>

	<!-- ۲. معرفی دقیق فایل‌های wwwroot به عنوان منابع Embedded -->
	<ItemGroup>
		<EmbeddedResource Include="wwwroot\**\*" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Modular.Core\Modular.Core.csproj" />
		<ProjectReference Include="..\..\Modular.Application\Modular.Application.csproj" />
		<ProjectReference Include="..\..\Modular.Infrastructure\Modular.Infrastructure.csproj" />
	</ItemGroup>
</Project>
