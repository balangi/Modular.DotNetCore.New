<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<BaseOutputPath>D:\- Source Repository -\- Test -\Modular.DotNetCore.New\Modular.Web\Modules</BaseOutputPath>

		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<CopyRefAssembliesToPublishDirectory>true</CopyRefAssembliesToPublishDirectory>
	
		<!-- ضروری برای ساخت مانیفست فایل‌های Embedded -->
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
	</PropertyGroup>

	<!-- معرفی فایل‌های داخل wwwroot به عنوان Embedded Resource -->
	<ItemGroup>
		<EmbeddedResource Include="wwwroot\**\*" />
	</ItemGroup>

	<ItemGroup>
		<!-- در صورت نیاز به استفاده از کنترلرها و ویژگی‌های وب در ماژول -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Modular.Core\Modular.Core.csproj" />
		<ProjectReference Include="..\..\Modular.Application\Modular.Application.csproj" />
		<ProjectReference Include="..\..\Modular.Infrastructure\Modular.Infrastructure.csproj" />
	</ItemGroup>

</Project>