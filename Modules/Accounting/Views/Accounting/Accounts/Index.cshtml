@{
    ViewData["Title"] = "Accounts";
}

<h1>Accounts</h1>

<table class="table">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Balance</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in Model ?? Enumerable.Empty<dynamic>())
        {
            <tr>
                <td>@account.Code</td>
                <td>@account.Name</td>
                <td>@account.Balance</td>
            </tr>
        }
    </tbody>
</table>
