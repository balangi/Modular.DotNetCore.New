@{
    ViewData["Title"] = "Accounts";
}

<h1>Accounts 1.3.0</h1>

@section Styles {
    <!-- فایل استاتیک بارگذاری شده از پوشه ماژول Accounting -->
    <link rel="stylesheet" href="~/modules/accounting/css/accounting.style.css" />
}

<table class="table">
    <thead>
        <tr>
            <th class="fonti">Code</th>
            <th>Name</th>
            <th>Balance</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in Model ?? Enumerable.Empty<dynamic>())
        {
            <tr>
                <td>@account.Code</td>
                <td>@account.Name</td>
                <td>@account.Balance</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="~/modules/accounting/js/accounting.script.js"></script>
}