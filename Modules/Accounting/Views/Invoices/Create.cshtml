@{
    ViewData["Title"] = "Create invoice";
}

<h1>Create invoice</h1>

<form method="post">
    <label>
        Number <input name="Number" required />
    </label>
    <label>
        Customer <input name="Customer" required />
    </label>
    <label>
        Amount <input name="Amount" type="number" min="0.01" step="0.01" required />
    </label>
    <label>
        Issued on <input name="IssuedOn" type="date" required />
    </label>
    <button type="submit">Create</button>
</form>
