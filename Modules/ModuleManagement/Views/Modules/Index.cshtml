@model IReadOnlyCollection<Modular.Modules.Contracts.ModuleRecord>
<h1>Modules</h1><a asp-action="Create">Create module</a>@if(TempData["Error"] is string e){<div>@e</div>}<table><tr><th>Name</th><th>Version</th><th>Status</th><th>Actions</th></tr>@foreach(var x in Model){<tr><td><a asp-action="Details" asp-route-id="@x.Id">@x.Name</a></td><td>@x.Version</td><td>@x.Status</td><td><a asp-action="Edit" asp-route-id="@x.Id">Edit</a>@if(x.Status==Modular.Modules.Contracts.ModuleStatus.Enabled){<form asp-action="Disable" asp-route-id="@x.Id" method="post"><button>Disable</button></form>}else{<form asp-action="Enable" asp-route-id="@x.Id" method="post"><button>Enable</button></form>}</td></tr>}</table>
