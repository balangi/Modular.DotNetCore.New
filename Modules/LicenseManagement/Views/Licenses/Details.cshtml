@model Modular.Modules.Contracts.LicenseRecord
<h1>License details</h1>@if(TempData["Error"] is string e){<div>@e</div>}<dl><dt>Key</dt><dd>@Model.Key</dd><dt>Product</dt><dd>@Model.Product</dd><dt>Customer</dt><dd>@Model.Customer</dd><dt>Tenant</dt><dd>@Model.TenantId</dd><dt>Status</dt><dd>@Model.Status</dd><dt>Expires</dt><dd>@Model.ExpiresUtc</dd></dl><form asp-action="Activate" asp-route-id="@Model.Id" method="post"><input name="tenantId" value="@Model.TenantId" /><button>Activate</button></form><h2>Features</h2><ul>@foreach(var f in Model.Features){<li>@f.Code (@f.Enabled)</li>}</ul><form asp-action="Feature" asp-route-id="@Model.Id" method="post"><input name="code" placeholder="Feature code" /><button>Assign feature</button></form><a asp-action="Index">Back</a>
