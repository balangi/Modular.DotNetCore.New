@model IReadOnlyList<Modular.Modules.FederationManagement.Application.ClubDto>
<div class="container py-4" dir="rtl"><h1 class="h3">ثبت ورزشکار</h1><form method="post" action="/federation/athletes/create" class="row g-3"><div class="col-md-6"><label class="form-label">نام</label><input name="FullName" class="form-control" required /></div><div class="col-md-6"><label class="form-label">کد ملی</label><input name="NationalId" class="form-control" required /></div><div class="col-md-6"><label class="form-label">تولد</label><input name="BirthDate" type="date" class="form-control" required /></div><div class="col-md-6"><label class="form-label">باشگاه</label><select name="ClubId" class="form-select">@foreach(var c in Model){<option value="@c.Id">@c.Name</option>}</select></div><div class="col-md-6"><label class="form-label">کمربند</label><select name="Belt" class="form-select"><option>White</option><option>Yellow</option><option>Green</option><option>Blue</option><option>Brown</option><option>Black</option></select></div><div class="col-md-6"><label class="form-label">رتبه</label><input name="Rank" type="number" min="1" max="10" value="1" class="form-control" /></div><button class="btn btn-primary">ثبت</button></form></div>
