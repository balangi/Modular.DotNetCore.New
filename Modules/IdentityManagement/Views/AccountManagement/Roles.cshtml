@{
    ViewData["Title"] = "Roles";
}

<h1>Roles</h1>

<table class="table">
    <thead>
        <tr>
            <th>Role</th>
            <th>Permissions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model ?? Enumerable.Empty<dynamic>())
        {
            <tr>
                <td>@role.Name</td>
                <td>@string.Join(", ", role.Permissions)</td>
            </tr>
        }
    </tbody>
</table>
